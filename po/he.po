msgid "Exclude pattern:"
msgstr "דפוס החרגה:"

#: src/preferences.vala:149
msgid "Regular expression"
msgstr "ביטוי רגולרי"

#: src/preferences.vala:150
msgid "Text matching this pattern will not be saved (e.g., passwords)"
msgstr "טקסט שתואם לתבנית זו לא יישמר (לדוגמה, סיסמאות)"

#: src/preferences.vala:163
msgid "History is encrypted with a key kept in your login keyring."
msgstr ""

#: src/preferences.vala:165
msgid "History is kept in memory only."
msgstr ""

#: src/preferences.vala:167
msgid "Waiting for the login keyring…"
msgstr ""

#: src/preferences.vala:169
msgid "The login keyring is unavailable, so history is kept in memory only."
msgstr ""

#: src/preferences.vala:171
msgid "History will be saved, encrypted, after the panel restarts."
msgstr ""

