#: src/preferences.vala:35
msgid "Clipboard Manager Preferences"
msgstr "העדפות מנהל הלוח"

#: src/preferences.vala:38
msgid "_Close"
msgstr "_סגירה"

#. General section
#: src/preferences.vala:47
msgid "General"
msgstr "כללי"

#: src/preferences.vala:54
msgid "History size:"
msgstr "גודל ההיסטוריה:"

#: src/preferences.vala:59
msgid "Maximum number of items to keep in history"
msgstr "מספר הפריטים המרבי לשמירה בהיסטוריה"

#: src/preferences.vala:63
msgid "Keep clipboard content when source closes"
msgstr "שמירת תוכן הלוח כשהמקור נסגר"

#: src/preferences.vala:64
msgid "Restore clipboard content when the application that copied it closes"
msgstr "שחזור תוכן הלוח כשהיישום שהעתיק אותו נסגר"

#: src/preferences.vala:65
msgid "Confirm before clearing history"
msgstr "אישור לפני ניקוי ההיסטוריה"

#: src/preferences.vala:67
msgid "Automatically paste when selecting from history"
msgstr "הדבקה אוטומטית בבחירה מההיסטוריה"

#: src/preferences.vala:70 src/preferences.vala:90
msgid "Not available on Wayland"
msgstr ""

#. History dialog section
#: src/preferences.vala:74
msgid "History Dialog"
msgstr ""

#: src/preferences.vala:76
msgid "Open the keyboard shortcut dialog at the mouse pointer"
msgstr ""

#: src/preferences.vala:77
msgid "Open the keyboard shortcut dialog next to the panel applet"
msgstr ""

#: src/preferences.vala:93
msgid ""
"To open the history with a key, add this command as a custom shortcut in the "
"Control Center:"
msgstr ""

#: src/preferences.vala:106
msgid "Copy command"
msgstr ""

#. Clipboard section
#: src/preferences.vala:115
msgid "Clipboard Sources"
msgstr "מקורות לוח"

#: src/preferences.vala:116
msgid "Track primary selection (middle-click paste)"
msgstr "מעקב אחרי הבחירה העיקרית (הדבקת לחיצה אמצעית)"

#: src/preferences.vala:117
msgid "Also save text selected with the mouse"
msgstr "שמירת טקסט שנבחר בעכבר גם כן"

#: src/preferences.vala:118
msgid "Synchronize clipboard and primary selection"
msgstr "סנכרון הלוח והבחירה העיקרית"

#: src/preferences.vala:119
msgid "Keep both selections synchronized"
msgstr "שמירת שתי הבחירות מסונכרנות"

#. Content types section
#: src/preferences.vala:122
msgid "Content Types"
msgstr "סוגי תוכן"

#: src/preferences.vala:123
msgid "Save images to history"
msgstr "שמירת תמונות להיסטוריה"

#: src/preferences.vala:124
msgid "Save file paths to history"
msgstr "שמירת נתיבי קבצים להיסטוריה"

#: src/preferences.vala:125
msgid "Show image previews in history"
msgstr "הצגת תצוגות מקדימות של תמונות בהיסטוריה"

#. Privacy section
#: src/preferences.vala:128
msgid "Privacy"
msgstr ""

#: src/preferences.vala:129
msgid "Save history to disk (encrypted)"
msgstr ""

#: src/preferences.vala:130
msgid ""
"When off, history is kept in memory only and is lost when the panel restarts"
msgstr ""

